{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit(./**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" oturum-basi", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" istem", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" duzenleme-oncesi", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" komut-oncesi", "timeout": 30 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" ajan-baslatma", "timeout": 10 }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" workflow-baslatma", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" duzenleme-sonrasi", "timeout": 10 }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" soru-sonrasi", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" ajan-dogarken", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/harness/hook/hook.sh\" durus", "timeout": 15 }
        ]
      }
    ]
  }
}
