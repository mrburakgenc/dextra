#!/bin/sh
# post-checkout <eski> <yeni> <dal_mi>: dal değişince üretilen dosyaları yeniler.
[ "${3:-0}" = "1" ] || exit 0
KOK=$(git rev-parse --show-toplevel) || exit 0
cd "$KOK" || exit 0
PYTHONDONTWRITEBYTECODE=1 python3 harness/h.py uret --sessiz || echo "[harness] uret başarısız: python3 harness/h.py uret" >&2
exit 0
