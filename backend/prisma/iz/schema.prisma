// İz veritabanının (dextra_iz) şeması. Bağlantı adresi prisma.iz.config.ts içinde verilir.
generator client {
  provider            = "prisma-client"
  output              = "../../src/shared/database/iz/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Değişiklik kaydı. Kimlik outbox_iz notunun kimliğidir; veritabanı varsayılanı yoktur.
// Asıl veritabanı başka veritabanı olduğu için yabancı anahtar yoktur.
model DegisiklikKaydi {
  id                    String   @id(map: "degisiklik_kaydi_ba") @db.Uuid
  istekId               String?  @map("istek_id") @db.Uuid
  kullaniciId           String   @map("kullanici_id") @db.Uuid
  uyelikId              String?  @map("uyelik_id") @db.Uuid
  yetenekId             String?  @map("yetenek_id") @db.Uuid
  isAdi                 String   @map("is_adi")
  baslatanKullaniciId   String?  @map("baslatan_kullanici_id") @db.Uuid
  veriSahibiKullaniciId String?  @map("veri_sahibi_kullanici_id") @db.Uuid
  kaynak                String
  kayitId               String   @map("kayit_id") @db.Uuid
  eylem                 String
  degisen               Json     @db.JsonB
  olusmaZamani          DateTime @map("olusma_zamani") @db.Timestamptz
  yazilmaZamani         DateTime @default(dbgenerated("clock_timestamp()")) @map("yazilma_zamani") @db.Timestamptz

  @@map("degisiklik_kaydi")
}

// Erişim kaydı (KR-013 Seçim 2 ve 6; TS-002 AK-10): yetki kapısından okuma yapan oturumlu istek başına
// bir satır. Kimlik uygulamada üretilir. Dönen kayıtların kimliklerini taşımaz; erişilen yer rota
// desenidir. İstek kimliği isteksiz okumalar için boş bırakılabilir (TS-003 Veri modeli).
model ErisimKaydi {
  id            String               @id(map: "erisim_kaydi_ba") @db.Uuid
  istekId       String?              @map("istek_id") @db.Uuid
  kullaniciId   String               @map("kullanici_id") @db.Uuid
  isAdi         String               @map("is_adi")
  erisilenYer   String               @map("erisilen_yer")
  kayitSayisi   Int                  @map("kayit_sayisi")
  olusmaZamani  DateTime             @map("olusma_zamani") @db.Timestamptz
  yazilmaZamani DateTime             @default(dbgenerated("clock_timestamp()")) @map("yazilma_zamani") @db.Timestamptz
  yetenekler    ErisimKaydiYetenek[]
  uyelikler     ErisimKaydiUyelik[]

  @@map("erisim_kaydi")
}

// Erişimde kullanılan yetenekler. Yetenek asıl veritabanındadır; ona yabancı anahtar yoktur.
model ErisimKaydiYetenek {
  erisimKaydiId String      @map("erisim_kaydi_id") @db.Uuid
  yetenekId     String      @map("yetenek_id") @db.Uuid
  erisimKaydi   ErisimKaydi @relation(fields: [erisimKaydiId], references: [id], onDelete: Restrict, map: "erisim_kaydi_yetenek_erisim_kaydi_id_ya")

  @@id([erisimKaydiId, yetenekId], map: "erisim_kaydi_yetenek_ba")
  @@map("erisim_kaydi_yetenek")
}

// Erişimde kullanılan üyelikler. Üyelik asıl veritabanındadır; ona yabancı anahtar yoktur.
model ErisimKaydiUyelik {
  erisimKaydiId String      @map("erisim_kaydi_id") @db.Uuid
  uyelikId      String      @map("uyelik_id") @db.Uuid
  erisimKaydi   ErisimKaydi @relation(fields: [erisimKaydiId], references: [id], onDelete: Restrict, map: "erisim_kaydi_uyelik_erisim_kaydi_id_ya")

  @@id([erisimKaydiId, uyelikId], map: "erisim_kaydi_uyelik_ba")
  @@map("erisim_kaydi_uyelik")
}

// Ret kaydı (TS-008 "Veri modeli" ve "Yazma"; kapanan AU-23 ve AU-31): reddi bir yasağın verdiği yazma
// başına bir satır; retler birleştirilmez, saklama süresi yoktur. Kimlik uygulamada üretilir. Kayıt
// oluşturmada boştur. Kayıt ve karar veren yasak asıl veritabanındadır; onlara yabancı anahtar yoktur.
model RetKaydi {
  id                String   @id(map: "ret_kaydi_ba") @db.Uuid
  istekId           String   @map("istek_id") @db.Uuid
  kullaniciId       String   @map("kullanici_id") @db.Uuid
  eylem             String
  kaynak            String
  kayitId           String?  @map("kayit_id") @db.Uuid
  kararVerenYasakId String   @map("karar_veren_yasak_id") @db.Uuid
  olusmaZamani      DateTime @map("olusma_zamani") @db.Timestamptz
  yazilmaZamani     DateTime @default(dbgenerated("clock_timestamp()")) @map("yazilma_zamani") @db.Timestamptz

  @@map("ret_kaydi")
}
