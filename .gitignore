# Harness'in yerel durumu: oturum kayıtları, defter, görev kartları, indeks
.harness/

# Python
__pycache__/
*.pyc

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
*.log
# Prisma'nın ürettiği istemci; pnpm -C backend prisma:generate ile yeniden üretilir
generated/

# Ortam dosyaları: gerçek değer taşıyan dosya depoya girmez
.env
.env.*
!.env.example

# İşletim sistemi
.DS_Store
.claude/worktrees/
# Kişisel Claude Code ayarı (izin kuralları); depoya girmez
.claude/settings.local.json
# Kişisel harness ayarı (görev komutlarının PATH'ine eklenecek klasörler); depoya girmez
harness.yerel.json
